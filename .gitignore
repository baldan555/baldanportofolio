# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MediaPipe WebAssembly runtime, copied from node_modules by scripts/copy-mediapipe.mjs
/public/mediapipe/wasm/

# Python: virtual env, caches and raw datasets stay local (the site uses the JSON they produce in src/data)
/ml/.venv/
/ml/data/
__pycache__/

# personal documents at the root (the public CV lives in public/)
/*.pdf

# CV build intermediates (docs/cv/build.mjs)
/docs/cv/out/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
