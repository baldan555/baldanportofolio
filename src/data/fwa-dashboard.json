l","channel":"Field sales"},{"theme":"Payment hassle","id":"FWA-000618","type":"Exit","nps":5,"text":"Bayar di konter repot, maunya bisa otomatis","en":"Paying at the counter is a hassle, I'd like it automatic","plan":"4G 20 Mbps","area":"Suburban","channel":"Partner agent"},{"theme":"Payment hassle","id":"FWA-001914","type":"Exit","nps":5,"text":"Lupa beli paket, tiba-tiba internet mati. Harusnya bisa lebih baik.","en":"Forgot to buy the package and the internet just stopped. It should be better.","plan":"4G 50 Mbps","area":"Rural","channel":"Retail outlet"},{"theme":"Moved house","id":"FWA-003148","type":"Exit","nps":5,"text":"Pindah alamat, dua minggu tidak bisa internet","en":"Changed address and had no internet for two weeks","plan":"4G 20 Mbps","area":"Urban","channel":"Field sales"},{"theme":"Moved house","id":"FWA-003186","type":"Exit","nps":6,"text":"Pindah rumah, layanan tidak bisa dipindah cepat","en":"Moved house and the service couldn't be moved quickly","plan":"5G 100 Mbps","area":"Urban","channel":"Retail outlet"},{"theme":"Fibre competitor","id":"FWA-001290","type":"Exit","nps":6,"text":"Tetangga pakai fiber, lebih cepat dengan harga mirip. Mohon dicek.","en":"Neighbours use fibre, faster for a similar price. Please look into it.","plan":"5G 100 Mbps","area":"Metro","channel":"Online"},{"theme":"Fibre competitor","id":"FWA-000229","type":"Exit","nps":6,"text":"Sudah ada fiber masuk di perumahan, pindah ke sana","en":"Fibre reached our estate, so we switched","plan":"4G 50 Mbps","area":"Urban","channel":"Partner agent"},{"theme":"Rarely used","id":"FWA-001136","type":"Exit","nps":6,"text":"Jarang dipakai, lebih sering pakai kuota HP. Kecewa sih.","en":"Hardly used it, mostly used my phone data. Pretty disappointing.","plan":"5G 100 Mbps","area":"Metro","channel":"Field sales"},{"theme":"Rarely used","id":"FWA-000235","type":"Exit","nps":4,"text":"Anak sudah kos, di rumah jarang ada yang pakai. Mohon dicek.","en":"The kids moved out, nobody at home uses it much. Please look into it.","plan":"4G 50 Mbps","area":"Rural","channel":"Online"},{"theme":"Works well","id":"FWA-001191","type":"Onboarding","nps":10,"text":"Stabil buat kerja dari rumah","en":"Stable for working from home","plan":"4G 50 Mbps","area":"Metro","channel":"Online"},{"theme":"Works well","id":"FWA-003669","type":"Relationship","nps":9,"text":"Anak-anak sekolah online lancar. Recommended.","en":"The kids' online school runs fine. Recommended.","plan":"4G 20 Mbps","area":"Suburban","channel":"Retail outlet"},{"theme":"Works well","id":"FWA-001596","type":"Relationship","nps":10,"text":"Pemasangan cepat, tinggal colok langsung jalan. Semoga tetap begini.","en":"Quick setup, plug in and it works. Hope it stays this way.","plan":"4G 50 Mbps","area":"Rural","channel":"Partner agent"},{"theme":"Works well","id":"FWA-000454","type":"Relationship","nps":10,"text":"Harga sesuai, jarang ada gangguan. Mantap!","en":"Fair price, rarely any problems. Great!","plan":"4G 50 Mbps","area":"Suburban","channel":"Field sales"},{"theme":"5G is faster","id":"FWA-003493","type":"Onboarding","nps":9,"text":"Ganti modem 5G gratis, sekarang streaming 4K aman. Recommended.","en":"Free swap to a 5G router, 4K streaming is fine now. Recommended.","plan":"5G 100 Mbps","area":"Urban","channel":"Retail outlet"},{"theme":"5G is faster","id":"FWA-001140","type":"Relationship","nps":10,"text":"Sejak pindah ke 5G jauh lebih cepat. Recommended.","en":"Much faster since moving to 5G. Recommended.","plan":"5G 100 Mbps","area":"Metro","channel":"Retail outlet"},{"theme":"5G is faster","id":"FWA-001850","type":"Onboarding","nps":10,"text":"5G kencang, malam juga tetap lancar. Terima kasih.","en":"5G is fast, smooth even at night. Thank you.","plan":"5G 100 Mbps","area":"Urban","channel":"Field sales"}],"newComplaints":[{"k":"Weak signal indoors","v":40.4},{"k":"Slow at busy hours","v":37.0},{"k":"Price","v":21.2},{"k":"Router problems","v":0.7},{"k":"Payment hassle","v":0.7}],"supportSla"